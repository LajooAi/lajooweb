{
  "name": "lajooweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed:insurers": "node scripts/import-insurer-facts.mjs",
    "db:import:pdf": "node scripts/import-policy-pdf.mjs",
    "db:import:pdf:batch": "node scripts/import-policy-pdf-batch.mjs",
    "knowledge:manifest": "node scripts/build-knowledge-manifest.mjs",
    "knowledge:candidate-facts": "node scripts/extract-candidate-facts.mjs",
    "knowledge:extract-verified-facts": "node scripts/extract-verified-facts-from-neon.mjs",
    "knowledge:apply-dates": "node scripts/apply-extracted-document-dates.mjs",
    "knowledge:review-brand-programs": "node scripts/review-generated-brand-program-facts.mjs",
    "knowledge:strict-readiness": "node scripts/audit-knowledge-strict-readiness.mjs",
    "knowledge:strict-readiness:ci": "node scripts/audit-knowledge-strict-readiness.mjs --fail-on-not-ready",
    "test:assistant": "node --test tests/assistant-intent.test.mjs tests/flow-guards.test.mjs tests/orchestrator.test.mjs tests/turn-planner.test.mjs tests/turn-knowledge-context.test.mjs tests/turn-instruction-stack.test.mjs tests/source-trace.test.mjs tests/conversation-audit-admin.test.mjs tests/ai-conversation-simulations.test.mjs tests/ai-response-quality-golden.test.mjs tests/approved-facts.test.mjs tests/insurance-engines.test.mjs tests/sandbox-vehicle-gateway.test.mjs tests/production-chat-parity.test.mjs tests/production-turn-instruction-builder.test.mjs tests/flow-handlers.test.mjs tests/pdpa-consent.test.mjs tests/pii-masking.test.mjs tests/pdpa-consent-audit-store.test.mjs tests/chat-session-store.test.mjs tests/pdf-import-metadata.test.mjs tests/document-dating.test.mjs tests/fact-extraction.test.mjs tests/database-fact-store.test.mjs tests/admin-knowledge-facts.test.mjs tests/strict-readiness.test.mjs tests/payment-provider.test.mjs tests/payment-store.test.mjs tests/payment-audit-store.test.mjs",
    "eval:intent": "node scripts/run-intent-eval.mjs",
    "eval:chaos": "node scripts/run-chaos-conversation-eval.mjs --runs 400 --seed 42",
    "eval:chaos:quick": "node scripts/run-chaos-conversation-eval.mjs --runs 150 --seed 42",
    "eval:capture:build": "node scripts/build-intent-eval-from-captures.mjs",
    "eval:flow": "node scripts/run-flow-eval.mjs",
    "eval:conversation": "node scripts/run-conversation-eval.mjs",
    "eval:ai-quality": "node scripts/run-ai-response-quality-eval.mjs",
    "eval:judge": "node scripts/run-llm-judge-eval.mjs",
    "eval:ab": "node scripts/run-llm-judge-eval.mjs --file tests/evals/llm-judge-transcripts.json",
    "eval:assistant": "npm run -s eval:intent && npm run -s eval:flow && npm run -s eval:conversation",
    "smoke:chat": "node scripts/run-chat-smoke.mjs",
    "smoke:chat:staging": "CHAT_SMOKE_BASE_URL=https://lajooweb-git-staging-lajoo-ais-projects.vercel.app node scripts/run-chat-smoke.mjs",
    "test:insurer:contract": "node scripts/run-insurer-adapter-contract.mjs",
    "test:insurer:contract:full": "node scripts/run-insurer-adapter-contract.mjs --mode full",
    "test:insurer:contract:batch": "node scripts/run-insurer-contract-batch.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.0.55",
    "@prisma/client": "^6.19.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "g": "^2.0.1",
    "next": "^15.5.7",
    "openai": "^6.9.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "prisma": "^6.19.2"
  }
}
