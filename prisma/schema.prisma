generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InsurerType {
  TAKAFUL
  CONVENTIONAL
}

enum FactType {
  TOWING
  CLAIMS
  BETTERMENT
  WINDSCREEN
  FLOOD
  ROADTAX
  ELIGIBILITY
  CONTACT
  GENERAL
}

enum FactStatus {
  DRAFT
  VERIFIED
  ARCHIVED
}

enum PromotionStatus {
  UPCOMING
  ACTIVE
  EXPIRED
  ARCHIVED
}

model Insurer {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  type            InsurerType
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  policyDocuments PolicyDocument[]
  facts           InsurerFact[]
  promotions      InsurerPromotion[]
  chunks          KnowledgeChunk[]
}

model PolicyDocument {
  id                  String             @id @default(cuid())
  insurerId           String
  insurer             Insurer            @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  title               String
  sourceFileName      String
  sourcePath          String?
  sourceRelativePath  String?
  checksum            String?
  category            String?
  documentType        String?
  language            String?
  coverageFamily      String?
  useForPrivateCarMvp Boolean            @default(false)
  versionLabel        String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  extractedText       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  chunks              KnowledgeChunk[]
  facts               InsurerFact[]
  promotions          InsurerPromotion[]

  @@unique([insurerId, sourceRelativePath])
  @@index([insurerId])
  @@index([insurerId, category])
  @@index([insurerId, documentType])
  @@index([language])
  @@index([useForPrivateCarMvp])
  @@index([effectiveFrom, effectiveTo])
}

model KnowledgeChunk {
  id               String         @id @default(cuid())
  insurerId        String
  insurer          Insurer        @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  policyDocumentId String
  policyDocument   PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)
  pageNumber       Int?
  chunkOrder       Int
  chunkText        String
  tokenCount       Int?
  createdAt        DateTime       @default(now())

  @@index([insurerId, policyDocumentId])
  @@index([policyDocumentId, chunkOrder])
}

model InsurerFact {
  id                 String          @id @default(cuid())
  insurerId          String
  insurer            Insurer         @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  policyDocumentId   String?
  policyDocument     PolicyDocument? @relation(fields: [policyDocumentId], references: [id], onDelete: SetNull)
  factType           FactType
  title              String
  value              String
  category           String?
  tags               String[]        @default([])
  advisorUse         String?
  confidence         String?
  validFrom          DateTime?
  validTo            DateTime?
  status             FactStatus      @default(DRAFT)
  sourcePage         Int?
  sourceExcerpt      String?
  sourceRelativePath String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([insurerId, factType])
  @@index([status])
  @@index([category])
  @@index([sourceRelativePath])
  @@index([validFrom, validTo])
}

model InsurerPromotion {
  id               String          @id @default(cuid())
  insurerId        String
  insurer          Insurer         @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  policyDocumentId String?
  policyDocument   PolicyDocument? @relation(fields: [policyDocumentId], references: [id], onDelete: SetNull)
  title            String
  description      String
  validFrom        DateTime
  validTo          DateTime
  status           PromotionStatus @default(UPCOMING)
  sourcePage       Int?
  sourceExcerpt    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([insurerId, validFrom, validTo])
  @@index([status])
}

model ChatSession {
  id          String        @id
  state       Json?
  publicState Json?
  lastIntent  Json?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expiresAt   DateTime
  messages    ChatMessage[]

  @@index([expiresAt])
  @@index([updatedAt])
}

model ChatMessage {
  id                 String      @id @default(cuid())
  sessionId          String
  session            ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role               String
  content            String
  messageOrder       Int
  summaryCard        Json?
  addOnsCard         Json?
  roadTaxCard        Json?
  paymentCard        Json?
  paymentSuccessCard Json?
  knowledgeTrace     Json?
  auditStatus        String?
  auditNote          String?
  auditedAt          DateTime?
  createdAt          DateTime    @default(now())

  @@index([sessionId, messageOrder])
  @@index([auditStatus])
}

model PaymentIntentSnapshot {
  id                      String    @id
  sessionId               String?
  provider                String    @default("mock")
  providerMode            String?
  providerPaymentIntentId String?
  status                  String    @default("requires_provider")
  paymentMethod           String?
  amount                  Decimal   @db.Decimal(12, 2)
  currency                String    @default("MYR")
  insurer                 String
  plate                   String
  insurance               Decimal   @db.Decimal(12, 2)
  addons                  Decimal   @db.Decimal(12, 2)
  tax                     Decimal   @db.Decimal(12, 2)
  roadtax                 Decimal   @db.Decimal(12, 2)
  breakdown               Json?
  checkoutData            Json?
  clientConfirmationToken String?
  transactionRef          String?
  paymentAvailable        Boolean   @default(false)
  canIssuePolicy          Boolean   @default(false)
  failureReason           String?
  confirmedAt             DateTime?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

model PaymentAuditEvent {
  id                String   @id @default(cuid())
  paymentId         String?
  provider          String
  direction         String
  eventType         String
  eventStatus       String
  signatureStatus   String?
  providerEventId   String?
  providerPaymentId String?
  requestId         String?
  rawBodyHash       String?
  payload           Json?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime @default(now())

  @@index([paymentId])
  @@index([provider, eventType])
  @@index([eventStatus])
  @@index([createdAt])
}

model PdpaConsentAuditEvent {
  id             String   @id @default(cuid())
  sessionId      String
  action         String   @default("accepted")
  consentVersion String
  acceptedAt     DateTime
  source         String   @default("chat")
  reason         String?
  messageHash    String?
  createdAt      DateTime @default(now())

  @@index([sessionId])
  @@index([consentVersion])
  @@index([acceptedAt])
  @@index([createdAt])
}
