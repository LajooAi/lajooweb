generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InsurerType {
  TAKAFUL
  CONVENTIONAL
}

enum FactType {
  TOWING
  CLAIMS
  BETTERMENT
  WINDSCREEN
  FLOOD
  ROADTAX
  ELIGIBILITY
  CONTACT
  GENERAL
}

enum FactStatus {
  DRAFT
  VERIFIED
  ARCHIVED
}

enum PromotionStatus {
  UPCOMING
  ACTIVE
  EXPIRED
  ARCHIVED
}

model Insurer {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  type            InsurerType
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  policyDocuments PolicyDocument[]
  facts           InsurerFact[]
  promotions      InsurerPromotion[]
  chunks          KnowledgeChunk[]
}

model PolicyDocument {
  id                  String             @id @default(cuid())
  insurerId           String
  insurer             Insurer            @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  title               String
  sourceFileName      String
  sourcePath          String?
  sourceRelativePath  String?
  checksum            String?
  category            String?
  documentType        String?
  language            String?
  coverageFamily      String?
  useForPrivateCarMvp Boolean            @default(false)
  versionLabel        String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  extractedText       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  chunks              KnowledgeChunk[]
  facts               InsurerFact[]
  promotions          InsurerPromotion[]

  @@unique([insurerId, sourceRelativePath])
  @@index([insurerId])
  @@index([insurerId, category])
  @@index([insurerId, documentType])
  @@index([language])
  @@index([useForPrivateCarMvp])
  @@index([effectiveFrom, effectiveTo])
}

model KnowledgeChunk {
  id                 String                 @id @default(cuid())
  insurerId          String
  insurer            Insurer                @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  policyDocumentId   String
  policyDocument     PolicyDocument         @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)
  pageNumber         Int?
  chunkOrder         Int
  chunkText          String
  tokenCount         Int?
  embedding          Unsupported("vector")?
  embeddingModel     String?
  embeddingUpdatedAt DateTime?
  createdAt          DateTime               @default(now())

  @@index([insurerId, policyDocumentId])
  @@index([policyDocumentId, chunkOrder])
  @@index([embeddingModel])
}

model InsurerFact {
  id                 String          @id @default(cuid())
  insurerId          String
  insurer            Insurer         @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  policyDocumentId   String?
  policyDocument     PolicyDocument? @relation(fields: [policyDocumentId], references: [id], onDelete: SetNull)
  factType           FactType
  title              String
  value              String
  category           String?
  tags               String[]        @default([])
  advisorUse         String?
  confidence         String?
  validFrom          DateTime?
  validTo            DateTime?
  status             FactStatus      @default(DRAFT)
  sourcePage         Int?
  sourceExcerpt      String?
  sourceRelativePath String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([insurerId, factType])
  @@index([status])
  @@index([category])
  @@index([sourceRelativePath])
  @@index([validFrom, validTo])
}

model InsurerPromotion {
  id               String          @id @default(cuid())
  insurerId        String
  insurer          Insurer         @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  policyDocumentId String?
  policyDocument   PolicyDocument? @relation(fields: [policyDocumentId], references: [id], onDelete: SetNull)
  title            String
  description      String
  validFrom        DateTime
  validTo          DateTime
  status           PromotionStatus @default(UPCOMING)
  sourcePage       Int?
  sourceExcerpt    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([insurerId, validFrom, validTo])
  @@index([status])
}

model ChatSession {
  id          String        @id
  state       Json?
  publicState Json?
  lastIntent  Json?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expiresAt   DateTime
  messages    ChatMessage[]

  @@index([expiresAt])
  @@index([updatedAt])
}

model ChatMessage {
  id                 String      @id @default(cuid())
  sessionId          String
  session            ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role               String
  content            String
  messageOrder       Int
  summaryCard        Json?
  addOnsCard         Json?
  roadTaxCard        Json?
  paymentCard        Json?
  paymentSuccessCard Json?
  knowledgeTrace     Json?
  auditStatus        String?
  auditNote          String?
  auditedAt          DateTime?
  createdAt          DateTime    @default(now())

  @@index([sessionId, messageOrder])
  @@index([auditStatus])
}

model PaymentIntentSnapshot {
  id                      String    @id
  sessionId               String?
  provider                String    @default("mock")
  providerMode            String?
  providerPaymentIntentId String?
  status                  String    @default("requires_provider")
  paymentMethod           String?
  amount                  Decimal   @db.Decimal(12, 2)
  currency                String    @default("MYR")
  insurer                 String
  plate                   String
  insurance               Decimal   @db.Decimal(12, 2)
  addons                  Decimal   @db.Decimal(12, 2)
  tax                     Decimal   @db.Decimal(12, 2)
  roadtax                 Decimal   @db.Decimal(12, 2)
  breakdown               Json?
  checkoutData            Json?
  clientConfirmationToken String?
  transactionRef          String?
  paymentAvailable        Boolean   @default(false)
  canIssuePolicy          Boolean   @default(false)
  failureReason           String?
  confirmedAt             DateTime?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

model PaymentAuditEvent {
  id                String   @id @default(cuid())
  paymentId         String?
  provider          String
  direction         String
  eventType         String
  eventStatus       String
  signatureStatus   String?
  providerEventId   String?
  providerPaymentId String?
  requestId         String?
  rawBodyHash       String?
  payload           Json?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime @default(now())

  @@index([paymentId])
  @@index([provider, eventType])
  @@index([eventStatus])
  @@index([createdAt])
}

model PdpaConsentAuditEvent {
  id             String   @id @default(cuid())
  sessionId      String
  action         String   @default("accepted")
  consentVersion String
  acceptedAt     DateTime
  source         String   @default("chat")
  reason         String?
  messageHash    String?
  createdAt      DateTime @default(now())

  @@index([sessionId])
  @@index([consentVersion])
  @@index([acceptedAt])
  @@index([createdAt])
}

model AdminUser {
  id                            String                              @id @default(cuid())
  email                         String                              @unique
  name                          String
  passwordHash                  String?
  status                        String                              @default("active")
  mfaStatus                     String                              @default("not_configured")
  mfaSecretEncrypted            String?
  mfaEnabledAt                  DateTime?
  mfaSecretUpdatedAt            DateTime?
  invitedAt                     DateTime?
  suspendedAt                   DateTime?
  bootstrapSource               String?
  createdAt                     DateTime                            @default(now())
  updatedAt                     DateTime                            @updatedAt
  lastActiveAt                  DateTime?
  roleAssignments               AdminRoleAssignment[]               @relation("AdminUserRoleAssignments")
  grantedRoleAssignments        AdminRoleAssignment[]               @relation("AdminRoleGrantedBy")
  sessions                      AdminSession[]
  inviteTokens                  AdminInviteToken[]                  @relation("AdminUserInviteTokens")
  createdInviteTokens           AdminInviteToken[]                  @relation("AdminInviteCreatedBy")
  inviteEmailEvents             AdminInviteEmailEvent[]             @relation("AdminInviteEmailEventActor")
  resendWebhookStatusChecks     AdminResendWebhookStatusCheck[]     @relation("AdminResendWebhookStatusCheckActor")
  webhookMonitoringAlerts       AdminWebhookMonitoringAlert[]       @relation("AdminWebhookMonitoringAlertActor")
  assignedWebhookMonitoringAlerts AdminWebhookMonitoringAlert[]      @relation("AdminWebhookMonitoringAlertAssignedTo")
  resolvedWebhookMonitoringAlerts AdminWebhookMonitoringAlert[]      @relation("AdminWebhookMonitoringAlertResolvedBy")
  webhookMonitoringAlertEvents   AdminWebhookMonitoringAlertEvent[]  @relation("AdminWebhookMonitoringAlertEventActor")
  webhookMonitoringAlertNotifications AdminWebhookMonitoringAlertNotification[] @relation("AdminWebhookMonitoringAlertNotificationRecipient")
  notificationPreferences       AdminNotificationPreference[]
  notificationDigests           AdminNotificationDigestEvent[]      @relation("AdminNotificationDigestUser")
  sentNotificationDigests       AdminNotificationDigestEvent[]      @relation("AdminNotificationDigestActor")
  notificationDigestJobAttempts AdminNotificationDigestJobAttempt[] @relation("AdminNotificationDigestJobAttemptActor")
  mfaChallenges                 AdminMfaChallenge[]
  requestedMfaRecoveries        AdminMfaRecoveryRequest[]           @relation("AdminMfaRecoveryRequester")
  targetedMfaRecoveries         AdminMfaRecoveryRequest[]           @relation("AdminMfaRecoveryTarget")
  approvedMfaRecoveries         AdminMfaRecoveryRequest[]           @relation("AdminMfaRecoveryApprover")
  mfaReminderEvents             AdminMfaRecoveryReminderEvent[]     @relation("AdminMfaRecoveryReminderActor")
  auditLogs                     AdminAuditLog[]                     @relation("AdminAuditActor")
  reviewedAuditLogs             AdminAuditLog[]                     @relation("AdminAuditReviewedBy")
  assignedAuditLogs             AdminAuditLog[]                     @relation("AdminAuditAssignedTo")
  auditAssignmentEvents         AdminAuditAssignmentEvent[]         @relation("AdminAuditAssignmentActor")
  piiRevealEvents               PiiRevealEvent[]
  exportEvents                  AdminExportEvent[]
  exportArtifactPolicies        AdminExportArtifactPolicy[]         @relation("AdminExportArtifactPolicyChangedBy")
  artifactAccesses              AdminExportArtifactAccess[]
  revokedArtifactAccesses       AdminExportArtifactAccess[]         @relation("AdminExportArtifactRevokedBy")
  scheduledJobAttempts          AdminScheduledJobAttempt[]          @relation("AdminScheduledJobAttemptActor")
  cronExecutionAlerts           AdminCronExecutionAlert[]           @relation("AdminCronExecutionAlertActor")
  assignedCronExecutionAlerts   AdminCronExecutionAlert[]           @relation("AdminCronExecutionAlertAssignedTo")
  resolvedCronExecutionAlerts   AdminCronExecutionAlert[]           @relation("AdminCronExecutionAlertResolvedBy")
  cronExecutionAlertEvents      AdminCronExecutionAlertEvent[]      @relation("AdminCronExecutionAlertEventActor")
  cronExecutionAlertNotifications AdminCronExecutionAlertNotification[] @relation("AdminCronExecutionAlertNotificationRecipient")
  paymentWebhookVerificationEvents AdminPaymentWebhookVerificationEvent[] @relation("AdminPaymentWebhookVerificationActor")
  assignedPaymentReconciliationItems AdminPaymentReconciliationItem[] @relation("AdminPaymentReconciliationAssignedTo")
  reviewedPaymentReconciliationItems AdminPaymentReconciliationItem[] @relation("AdminPaymentReconciliationReviewedBy")
  paymentReconciliationEvents AdminPaymentReconciliationEvent[] @relation("AdminPaymentReconciliationEventActor")
  createdPaymentExceptions AdminPaymentException[] @relation("AdminPaymentExceptionCreatedBy")
  assignedPaymentExceptions AdminPaymentException[] @relation("AdminPaymentExceptionAssignedTo")
  resolvedPaymentExceptions AdminPaymentException[] @relation("AdminPaymentExceptionResolvedBy")
  paymentExceptionEvents AdminPaymentExceptionEvent[] @relation("AdminPaymentExceptionEventActor")
  ownedRenewalOpsCases AdminRenewalOpsCase[] @relation("AdminRenewalOpsOwner")
  createdRenewalOpsCases AdminRenewalOpsCase[] @relation("AdminRenewalOpsCreatedBy")
  updatedRenewalOpsCases AdminRenewalOpsCase[] @relation("AdminRenewalOpsUpdatedBy")
  renewalOpsStatusEvents AdminRenewalOpsStatusEvent[] @relation("AdminRenewalOpsStatusActor")
  renewalQuoteLifecycleEvents AdminRenewalQuoteLifecycleEvent[] @relation("AdminRenewalQuoteLifecycleActor")
  insurerPartnerSubmissions AdminInsurerPartnerSubmission[] @relation("AdminInsurerPartnerSubmissionActor")
  manualIssuanceTasks AdminManualIssuanceTask[] @relation("AdminManualIssuanceTaskActor")
  assignedManualIssuanceTasks AdminManualIssuanceTask[] @relation("AdminManualIssuanceTaskAssignedTo")
  policyDocumentUploads AdminPolicyDocumentVerification[] @relation("AdminPolicyDocumentUploadedBy")
  policyDocumentReviews AdminPolicyDocumentVerification[] @relation("AdminPolicyDocumentReviewedBy")

  @@index([status])
  @@index([mfaStatus])
  @@index([lastActiveAt])
}

model AdminInviteToken {
  id                String                  @id @default(cuid())
  userId            String
  user              AdminUser               @relation("AdminUserInviteTokens", fields: [userId], references: [id], onDelete: Cascade)
  email             String
  role              String
  tokenHash         String                  @unique
  status            String                  @default("pending")
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  createdByUserId   String?
  createdBy         AdminUser?              @relation("AdminInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdReason     String?
  deliveryStatus    String                  @default("manual_required")
  deliveryProvider  String?
  deliveryMessageId String?
  deliveryError     String?
  deliverySentAt    DateTime?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime                @default(now())
  emailEvents       AdminInviteEmailEvent[]

  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@index([deliveryStatus])
}

model AdminInviteEmailEvent {
  id                  String                   @id @default(cuid())
  inviteTokenId       String?
  inviteToken         AdminInviteToken?        @relation(fields: [inviteTokenId], references: [id], onDelete: SetNull)
  actorUserId         String?
  actorUser           AdminUser?               @relation("AdminInviteEmailEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  email               String
  provider            String
  status              String
  errorClass          String?
  errorMessage        String?
  messageId           String?
  domain              String?
  providerEnvironment String?
  metadata            Json?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime                 @default(now())
  webhookEvents       AdminEmailWebhookEvent[]

  @@index([inviteTokenId])
  @@index([actorUserId])
  @@index([provider])
  @@index([status])
  @@index([errorClass])
  @@index([createdAt])
}

model AdminEmailWebhookEvent {
  id                 String                 @id @default(cuid())
  inviteEmailEventId String?
  inviteEmailEvent   AdminInviteEmailEvent? @relation(fields: [inviteEmailEventId], references: [id], onDelete: SetNull)
  provider           String                 @default("resend")
  svixId             String?                @unique
  eventType          String
  status             String
  providerEventId    String?
  providerMessageId  String?
  recipientMasked    String?
  emailDigest        String?
  verificationStatus String                 @default("verified")
  errorClass         String?
  payloadSummary     Json?
  linkedBy           String?
  ipAddress          String?
  userAgent          String?
  receivedAt         DateTime               @default(now())
  createdAt          DateTime               @default(now())

  @@index([inviteEmailEventId])
  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([providerMessageId])
  @@index([verificationStatus])
  @@index([receivedAt])
  @@index([createdAt])
}

model AdminResendWebhookStatusCheck {
  id                    String                        @id @default(cuid())
  actorUserId           String?
  actorUser             AdminUser?                    @relation("AdminResendWebhookStatusCheckActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  monitoringAlerts      AdminWebhookMonitoringAlert[]
  provider              String                        @default("resend")
  status                String
  endpointUrl           String?
  endpointMatched       Boolean                       @default(false)
  matchedWebhookId      String?
  matchedWebhookStatus  String?
  matchedWebhookEvents  Json?
  webhookCount          Int                           @default(0)
  requiredEventsMissing Json?
  errorClass            String?
  errorMessage          String?
  providerEnvironment   String?
  ipAddress             String?
  userAgent             String?
  metadata              Json?
  checkedAt             DateTime                      @default(now())
  createdAt             DateTime                      @default(now())

  @@index([actorUserId])
  @@index([provider])
  @@index([status])
  @@index([endpointMatched])
  @@index([matchedWebhookStatus])
  @@index([errorClass])
  @@index([checkedAt])
  @@index([createdAt])
}

model AdminWebhookMonitoringAlert {
  id                    String                         @id @default(cuid())
  actorUserId           String?
  actorUser             AdminUser?                     @relation("AdminWebhookMonitoringAlertActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  assignedToUserId      String?
  assignedTo            AdminUser?                     @relation("AdminWebhookMonitoringAlertAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedByUserId      String?
  resolvedBy            AdminUser?                     @relation("AdminWebhookMonitoringAlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  statusCheckId         String?
  statusCheck           AdminResendWebhookStatusCheck? @relation(fields: [statusCheckId], references: [id], onDelete: SetNull)
  provider              String                         @default("resend")
  alertType             String
  priority              String                         @default("normal")
  severity              String                         @default("warning")
  status                String                         @default("open")
  message               String
  note                  String?
  snoozedUntil          DateTime?
  endpointUrl           String?
  providerStatus        String?
  secretConfigured      Boolean?
  endpointMatched       Boolean?
  requiredEventsMissing Json?
  lastVerifiedWebhookAt DateTime?
  detectedAt            DateTime                       @default(now())
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
  ipAddress             String?
  userAgent             String?
  metadata              Json?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  workflowEvents        AdminWebhookMonitoringAlertEvent[]
  notifications         AdminWebhookMonitoringAlertNotification[]

  @@index([actorUserId])
  @@index([assignedToUserId])
  @@index([resolvedByUserId])
  @@index([statusCheckId])
  @@index([provider])
  @@index([alertType])
  @@index([priority])
  @@index([severity])
  @@index([status])
  @@index([snoozedUntil])
  @@index([detectedAt])
  @@index([acknowledgedAt])
  @@index([resolvedAt])
  @@index([createdAt])
}

model AdminWebhookMonitoringAlertEvent {
  id              String                       @id @default(cuid())
  alertId         String
  alert           AdminWebhookMonitoringAlert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actorUser       AdminUser?                   @relation("AdminWebhookMonitoringAlertEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action          String
  previousStatus  String?
  status          String
  previousPriority String?
  priority        String?
  assignedToUserId String?
  reason          String
  note            String?
  snoozedUntil    DateTime?
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime                     @default(now())

  @@index([alertId])
  @@index([actorUserId])
  @@index([action])
  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@index([snoozedUntil])
  @@index([createdAt])
}

model AdminWebhookMonitoringAlertNotification {
  id                    String                      @id @default(cuid())
  alertId               String
  alert                 AdminWebhookMonitoringAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  recipientUserId       String?
  recipient             AdminUser?                  @relation("AdminWebhookMonitoringAlertNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientRole         String?
  status                String
  deliveryProvider      String?
  deliveryStatus        String?
  deliveryMessageId     String?
  errorClass            String?
  errorMessage          String?
  manualFallback        Boolean                     @default(false)
  reason                String
  ipAddress             String?
  userAgent             String?
  metadata              Json?
  createdAt             DateTime                    @default(now())

  @@index([alertId])
  @@index([recipientUserId])
  @@index([recipientRole])
  @@index([status])
  @@index([deliveryStatus])
  @@index([errorClass])
  @@index([manualFallback])
  @@index([createdAt])
}

model AdminNotificationPreference {
  id                    String    @id @default(cuid())
  userId                String
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              String
  emailEnabled          Boolean   @default(true)
  frequency             String    @default("immediate")
  manualFallbackEnabled Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, category])
  @@index([userId])
  @@index([category])
  @@index([frequency])
}

model AdminNotificationDigestEvent {
  id                 String     @id @default(cuid())
  userId             String
  user               AdminUser  @relation("AdminNotificationDigestUser", fields: [userId], references: [id], onDelete: Cascade)
  actorUserId        String?
  actorUser          AdminUser? @relation("AdminNotificationDigestActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  frequency          String
  status             String
  deliveryProvider   String?
  deliveryStatus     String?
  deliveryMessageId  String?
  deliveryErrorClass String?
  deliveryError      String?
  manualFallback     Boolean    @default(false)
  categorySummary    Json?
  itemCount          Int        @default(0)
  reason             String?
  ipAddress          String?
  userAgent          String?
  sentAt             DateTime?
  createdAt          DateTime   @default(now())

  @@index([userId])
  @@index([actorUserId])
  @@index([frequency])
  @@index([status])
  @@index([deliveryStatus])
  @@index([deliveryProvider])
  @@index([manualFallback])
  @@index([sentAt])
  @@index([createdAt])
}

model AdminNotificationDigestJobAttempt {
  id                  String     @id @default(cuid())
  actorUserId         String?
  actorUser           AdminUser? @relation("AdminNotificationDigestJobAttemptActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  jobName             String     @default("admin-notification-digest")
  frequency           String
  triggerSource       String     @default("manual_admin")
  status              String
  reason              String?
  targetUserCount     Int        @default(0)
  attemptedCount      Int        @default(0)
  sentCount           Int        @default(0)
  manualFallbackCount Int        @default(0)
  failedCount         Int        @default(0)
  skippedCount        Int        @default(0)
  itemCount           Int        @default(0)
  deliveryProvider    String?
  deliveryStatus      String?
  errorClass          String?
  errorMessage        String?
  liveCron            Boolean    @default(false)
  ipAddress           String?
  userAgent           String?
  metadata            Json?
  startedAt           DateTime   @default(now())
  finishedAt          DateTime?
  createdAt           DateTime   @default(now())

  @@index([actorUserId])
  @@index([jobName])
  @@index([frequency])
  @@index([triggerSource])
  @@index([status])
  @@index([deliveryStatus])
  @@index([liveCron])
  @@index([startedAt])
  @@index([createdAt])
}

model AdminScheduledJobAttempt {
  id              String     @id @default(cuid())
  actorUserId     String?
  actorUser       AdminUser? @relation("AdminScheduledJobAttemptActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  jobName         String
  jobKind         String
  triggerSource   String     @default("cron")
  status          String
  reason          String?
  matchedCount    Int        @default(0)
  processedCount  Int        @default(0)
  successCount    Int        @default(0)
  failedCount     Int        @default(0)
  skippedCount    Int        @default(0)
  itemCount       Int        @default(0)
  liveCron        Boolean    @default(false)
  errorClass      String?
  errorMessage    String?
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  startedAt       DateTime   @default(now())
  finishedAt      DateTime?
  createdAt       DateTime   @default(now())
  cronExecutionAlerts AdminCronExecutionAlert[]

  @@index([actorUserId])
  @@index([jobName])
  @@index([jobKind])
  @@index([triggerSource])
  @@index([status])
  @@index([liveCron])
  @@index([startedAt])
  @@index([createdAt])
}

model AdminCronExecutionAlert {
  id                    String                       @id @default(cuid())
  actorUserId           String?
  actorUser             AdminUser?                   @relation("AdminCronExecutionAlertActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  assignedToUserId      String?
  assignedTo            AdminUser?                   @relation("AdminCronExecutionAlertAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedByUserId      String?
  resolvedBy            AdminUser?                   @relation("AdminCronExecutionAlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  scheduledJobAttemptId String?
  scheduledJobAttempt   AdminScheduledJobAttempt?    @relation(fields: [scheduledJobAttemptId], references: [id], onDelete: SetNull)
  jobName               String
  jobKind               String
  alertType             String
  priority              String                       @default("normal")
  severity              String                       @default("warning")
  status                String                       @default("open")
  message               String
  note                  String?
  snoozedUntil          DateTime?
  lastAttemptStatus     String?
  lastAttemptAt         DateTime?
  lastSuccessAt         DateTime?
  failureCount          Int                          @default(0)
  skippedCount          Int                          @default(0)
  staleThresholdMinutes Int?
  detectedAt            DateTime                     @default(now())
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
  ipAddress             String?
  userAgent             String?
  metadata              Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  workflowEvents        AdminCronExecutionAlertEvent[]
  notifications         AdminCronExecutionAlertNotification[]

  @@index([actorUserId])
  @@index([assignedToUserId])
  @@index([resolvedByUserId])
  @@index([scheduledJobAttemptId])
  @@index([jobName])
  @@index([jobKind])
  @@index([alertType])
  @@index([priority])
  @@index([severity])
  @@index([status])
  @@index([snoozedUntil])
  @@index([lastAttemptAt])
  @@index([lastSuccessAt])
